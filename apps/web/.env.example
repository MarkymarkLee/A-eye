# Local SQLite file (default: apps/web/.data/a-eye.db)
# A_EYE_DB_PATH=

# Photo storage. Leave S3_BUCKET unset to store photos in apps/web/.data/uploads.
# S3_BUCKET=a-eye-submissions
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# For Cloudflare R2 (production) or MinIO (local):
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# Local photo dir when S3_BUCKET is unset (Render: /var/data/uploads)
# A_EYE_UPLOAD_DIR=

# Public RPC for raffle entropy, AUSD transfers and balances
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ---- Payments: x402 + AUSD on Base Sepolia ----
# Treasury wallet: receives question bounties over x402 and pays raffle winners / refunds expired questions.
# Setting either of these turns on x402 for POST /api/questions. The key is needed to send payouts and refunds.
# A_EYE_TREASURY_PRIVATE_KEY=
# A_EYE_TREASURY_ADDRESS=0x293214291186180810902D97994c2C72fE88255A
# x402 facilitator (default https://x402.org/facilitator)
# X402_FACILITATOR_URL=
# Dev bypass: allow unpaid POST /api/questions (also the default outside production when no treasury is set)
# ALLOW_UNPAID_QUESTIONS=1

# ---- Not used yet. See "What we need to run it" in PLAN.md ----
# Milestone 4: demo agent (apps/demo-agent)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# AGENT_VISION=1        # 0 disables sending photos to the LLM
# A_EYE_API_URL=https://a-eye-1zsv.onrender.com
# A_EYE_MCP_COMMAND=    # e.g. "tsx packages/mcp/src/index.ts"; default: dist build, else tsx src
# GEMINI_API_KEY=
# GEMINI_API_SECRET=
# GEMINI_MARKET_SEARCH=San Francisco
# GEMINI_ORDER_QTY=1
# ORACLE_DIVERGENCE_PTS=15
# ORACLE_MIN_RESPONSES=3
# Stretch 1
# CONTEXT_DEV_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# Stretch 2: XRPL testnet
# XRPL_TREASURY_SEED=
# XRPL_ISSUER_SEED=
