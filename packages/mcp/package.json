    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@a-eye/shared": "*",
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "^22.20.5",
    "@x402/mcp": "^2.28.0",
    "esbuild": "^0.27.7",
    "tsup": "^8.5.0",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  }
