{
  "name": "a-eye-mcp",
  "version": "0.1.0",
  "description": "MCP server for asking real people location-based questions with x402 payments",
  "license": "MIT",
  "type": "module",
  "keywords": ["mcp", "x402", "ai-agents", "location", "crowdsourcing"],
  "repository": {
    "type": "git",
    "url": "https://github.com/PeytonLi/A-eye",
    "directory": "packages/mcp"
  },
  "homepage": "https://a-eye-1zsv.onrender.com/agents",
  "bin": {
    "a-eye-mcp": "dist/index.js"
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup && node scripts/build-mcpb.mjs",
    "prepack": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
