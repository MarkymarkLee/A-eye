# packages/mcp (run by the agent)
A_EYE_API_URL=http://localhost:3000
A_EYE_AGENT_LABEL=mcp-agent
# Agent wallet that pays question bounties over x402 (falls back to A_EYE_AGENT_PRIVATE_KEY).
# Without it, POST /api/questions 402s become tool errors. When set, the agent is identified by this wallet address.
AGENT_PRIVATE_KEY=
# Optional per-payment spend cap in USD (default 25)
# A_EYE_MAX_PAYMENT_USD=25
